# Copiá este archivo a backend/.env y completá los valores (backend/.env no se sube a git).

# PostgreSQL (Neon): Dashboard > Connect
# "Pooled" (host con -pooler): la usa la API
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# "Direct": la usan los scrapers, las planillas y init_db.py
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Opcional pero recomendado: sin clave, Google Books suele devolver 429 (cuota agotada)
GOOGLE_BOOKS_API_KEY=

# En producción: dominios del frontend que pueden llamar a la API, separados por coma (por defecto: cualquiera)
ALLOWED_ORIGINS=
